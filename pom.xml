<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent rather than an import: the versions it names once are properties, and an
         imported BOM brings only its dependency management. -->
    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-bom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>sokar-message-matrix</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Sokar Message Matrix</name>
    <description>The Matrix transport: a project's room, where tasks talk</description>
    <url>https://github.com/sokar-ai/sokar-message-matrix/</url>

    <scm>
        <connection>scm:git:git://github.com/sokar-ai/sokar-message-matrix.git</connection>
        <developerConnection>scm:git:git@github.com:sokar-ai/sokar-message-matrix.git</developerConnection>
        <url>https://github.com/sokar-ai/sokar-message-matrix/</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/sokar-ai/sokar-message-matrix/issues</url>
    </issueManagement>

    <properties>
        <jspecify.version>1.0.1</jspecify.version>
        <assertj.version>3.27.7</assertj.version>
        <jackson.version>2.22.1</jackson.version>
        <main.class>org.fuin.sokar.message.matrix.Main</main.class>
        <transport.name>sokar-message-transport-matrix</transport.name>
        <!-- Named as sokar names its snapshots; CI sets the run and clears the local suffix. -->
        <sokar.snapshot.suffix>+local.${maven.build.timestamp}</sokar.snapshot.suffix>
        <deb.version>0.1.0~snapshot.${sokar.snapshot.run}${sokar.snapshot.suffix}</deb.version>
        <rpm.release>snapshot.${sokar.snapshot.run}</rpm.release>
        <package.doc>/usr/share/doc/${transport.name}</package.doc>
        <jdeb.version>1.14</jdeb.version>
        <rpm-maven-plugin.version>2.3.0</rpm-maven-plugin.version>
        <!-- What the integration tests run under -Pnative. -->
        <transport.executable>${project.build.directory}/${transport.name}</transport.executable>
    </properties>

    <!-- The parent is a snapshot published there, and a build must not depend on one machine's settings. -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.release.version}</release>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepExcludedPaths:.*/src/test/.* -XepOpt:NullAway:OnlyNullMarked=true</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!-- The integration tests run against the real homeserver in podman, which every Sokar machine has. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The build's own tools, resolved by Maven so CI can run them before the pinned JDK is there:
             sokar-machines installs that JDK, sokar-release refuses an unpinned action. Their versions
             come from the parent. -->
        <profile>
            <id>ci-tools</id>
            <dependencies>
                <dependency>
                    <groupId>org.fuin.sokar</groupId>
                    <artifactId>sokar-machines</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.fuin.sokar</groupId>
                    <artifactId>sokar-release</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <!-- The installed transport is a native executable, so it needs no Java at run time. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>${transport.name}</imageName>
                            <mainClass>${main.class}</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The bill of what the executable is built from, shipped beside it. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>sbom.cdx</outputName>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <version>${jdeb.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <deb>${project.build.directory}/${transport.name}_${deb.version}_amd64.deb</deb>
                                    <snapshotExpand>false</snapshotExpand>
                                    <dataSet>
                                        <data>
                                            <src>${project.build.directory}/${transport.name}</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/libexec/sokar/transports</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>755</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.build.directory}/sbom.cdx.json</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/LICENSE</src>
                                            <dst>copyright</dst>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>rpm-maven-plugin</artifactId>
                        <version>${rpm-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>attached-rpm</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>${transport.name}</name>
                            <version>0.1.0</version>
                            <release>${rpm.release}</release>
                            <license>GPL-3.0-or-later</license>
                            <group>Applications/Communications</group>
                            <summary>The Matrix transport for Sokar</summary>
                            <description>Carries messages Sokar's filter let through into a project's Matrix room, and brings the room's messages back into a task's mailbox.</description>
                            <url>https://github.com/sokar-ai/sokar-message-matrix</url>
                            <needarch>x86_64</needarch>
                            <requires>
                                <require>sokar</require>
                                <require>glibc &gt;= 2.34</require>
                                <require>zlib</require>
                            </requires>
                            <defaultUsername>root</defaultUsername>
                            <defaultGroupname>root</defaultGroupname>
                            <mappings>
                                <mapping>
                                    <directory>/usr/libexec/sokar/transports</directory>
                                    <directoryIncluded>false</directoryIncluded>
                                    <filemode>755</filemode>
                                    <sources>
                                        <source>
                                            <location>${project.build.directory}/${transport.name}</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <!-- The directory on its own: a mapping with files gives its directory the files' mode. -->
                                <mapping>
                                    <directory>${package.doc}</directory>
                                    <filemode>755</filemode>
                                </mapping>
                                <mapping>
                                    <directory>${package.doc}</directory>
                                    <directoryIncluded>false</directoryIncluded>
                                    <filemode>644</filemode>
                                    <documentation>true</documentation>
                                    <sources>
                                        <source>
                                            <location>${project.build.directory}/sbom.cdx.json</location>
                                        </source>
                                        <source>
                                            <location>${project.basedir}/LICENSE</location>
                                        </source>
                                    </sources>
                                </mapping>
                            </mappings>
                        </configuration>
                    </plugin>
                    <!-- The integration tests run the executable itself, as Sokar does, not the classes in this JVM. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <transport.executable>${transport.executable}</transport.executable>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
