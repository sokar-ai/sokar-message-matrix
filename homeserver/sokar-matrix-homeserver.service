# The local homeserver of one account that runs Sokar, on loopback. Shipped disabled, like sokard: the
# account enables it with `systemctl --user enable --now sokar-matrix-homeserver`. Its port and server
# name come from ~/.config/sokar/matrix/homeserver.conf when set there. The image is filled in at build
# time from the FROM line of homeserver/Dockerfile, the one place it is pinned.
[Unit]
Description=The Matrix homeserver Sokar's transport talks to, on loopback
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
RequiresMountsFor=%t/containers

[Service]
Environment=SOKAR_MATRIX_PORT=8008
Environment=SOKAR_MATRIX_SERVER_NAME=localhost
EnvironmentFile=-%h/.config/sokar/matrix/homeserver.conf
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecStartPre=/usr/libexec/sokar/transports/sokar-message-transport-matrix homeserver-token
# The shape podman's own quadlet generator gives a container unit, so a stop is a clean one. The container
# is named outside `sokar-`, which is Sokar's own: every container named so is a task to it. It is acted on
# by the id podman gave this unit, never by its name: a container somebody else named so is neither
# replaced nor removed - the start fails and says the name is taken. One of this unit's own, left by a
# crash, is removed by its id before the start.
ExecStartPre=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
ExecStart=/usr/bin/podman run --rm -d --cidfile=%t/%N.cid --name matrix-homeserver \
    --sdnotify=conmon --cgroups=split \
    -e TUWUNEL_SERVER_NAME=${SOKAR_MATRIX_SERVER_NAME} \
    -e TUWUNEL_ADDRESS=0.0.0.0 -e TUWUNEL_PORT=8008 -e TUWUNEL_DATABASE_PATH=/data \
    -e TUWUNEL_ALLOW_FEDERATION=false -e TUWUNEL_ALLOW_REGISTRATION=true \
    -e TUWUNEL_REGISTRATION_TOKEN_FILE=/run/secrets/registration-token \
    -v %h/.config/sokar/matrix/registration-token:/run/secrets/registration-token:ro,Z \
    -v sokar-matrix-homeserver:/data \
    -p 127.0.0.1:${SOKAR_MATRIX_PORT}:8008 \
    @IMAGE@
ExecStop=/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
ExecStopPost=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
KillMode=mixed
Delegate=yes
SyslogIdentifier=%N
Type=notify
NotifyAccess=all
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
